# Copy to .env.local for local development (git-ignored). Leave empty to see the
# "guestbook not connected yet" state; everything else on the site still works.

# Local Worker (cd guestbook-api && npm run dev):
VITE_GUESTBOOK_API=http://127.0.0.1:8787
# Cloudflare's official test site key: always passes. Use your real key in production.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
